# ============================================================================
# DevDocs AI — environment variables
# Copy to `.env` (gitignored) and fill in. docker-compose reads this file.
# NEVER commit real secrets. `.env` is ignored; only `.env.example` is tracked.
# ============================================================================

# ---- PostgreSQL (with pgvector) ----
POSTGRES_USER=devdocs
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=devdocs
POSTGRES_PORT=5432

# Connection string the API uses (host is the compose service name in Docker).
ConnectionStrings__Default=Host=db;Port=5432;Database=devdocs;Username=devdocs;Password=change-me-locally

# ---- API ----
ASPNETCORE_ENVIRONMENT=Development
API_PORT=8080

# ---- JWT (Phase 2) ----
# Generate a long random value, e.g.: openssl rand -base64 48
Jwt__SigningKey=replace-with-a-long-random-secret-at-least-32-bytes
Jwt__Issuer=devdocs-ai
Jwt__Audience=devdocs-ai
Jwt__AccessTokenMinutes=15
Jwt__RefreshTokenDays=14

# ---- AI provider: Google Gemini (free tier) — Phase 5 ----
# Free API key from Google AI Studio: https://aistudio.google.com/apikey
# Embeddings: gemini-embedding-001 (768-dim). Chat: Gemini Flash (needs generateContent quota — free tier may be 0).
# Not needed for Phases 1-4. Never commit the real key.
Gemini__ApiKey=
Gemini__EmbeddingModel=gemini-embedding-001
Gemini__EmbeddingDimensions=768
Gemini__ChatModel=gemini-2.0-flash

# ---- File storage (local disk for MVP) ----
Storage__Provider=Local
Storage__RootPath=./storage

# ---- Frontend ----
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
WEB_PORT=3000
